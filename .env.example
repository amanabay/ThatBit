# Copy to .env; never commit credentials. Node loads this file server-side.
PORT=4317
DATA_DIR=.data
# Readable CLI logs and rotating private JSONL files are on by default.
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_TO_FILE=true
TWITCH_CLIENT_ID=
TWITCH_CHANNEL=
# Public-client app, obtained via npm run twitch:login
# Channel is your own username, without @/URL. Login requests read-only chat.
# Future sharing permission: npm run twitch:login -- --with-sharing
# Paid providers intentionally disabled until budget/provider approval.
# Optional local ASR; no audio leaves this machine:
# WHISPER_BIN=/absolute/path/to/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-model.bin
# Windows paths: use quoted forward slashes, e.g.
# WHISPER_BIN="C:/Projects/ReplyLink/.data/models/whisper.cpp/build/bin/Release/whisper-cli.exe"
# WHISPER_MODEL="C:/Projects/ReplyLink/.data/models/ggml-base.en.bin"
# Enable only after authorized hosting and exact-link verification:
# PUBLIC_BASE_URL=https://your-verified-reader.example
# OBS: enable authenticated loopback WebSocket and configure split-capable MKV recording.
# Select the 1-based audio stream position in the file (1–6), containing the intended mix.
# Verify OBS source mute/meters; mixer track checkbox numbers may differ from file positions.
OBS_RECORD_DIR=
# Windows example: OBS_RECORD_DIR="C:/Users/Aman/Videos/ReplyLink"
OBS_PASSWORD=
OBS_AUDIO_TRACK=1
MATCH_MODEL_DIR=
# npm run dev:local supplies these automatically for local reader publishing.
# READER_URL=http://127.0.0.1:4320
# READER_WRITE_TOKEN=generated-local-token-at-least-32-characters
# READER_PUBLIC_ORIGIN=https://your-future-reader.example
# Context-aware private drafts; set false to retain the single-answer baseline.
# Authored regression gates passed; real-world/independent validation remains pending.
ASSISTANCE_V2=true
