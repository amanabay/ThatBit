{
  "name": "replylink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node --import tsx apps/server/src/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx apps/server/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:boundaries": "node --import tsx scripts/boundaries.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run check:boundaries && npm test && npm run eval:matching && npm run test:e2e",
    "demo": "node --import tsx scripts/demo.ts",
    "media:smoke": "node --import tsx --test tests/media.test.ts",
    "obs:doctor": "node --import tsx scripts/obs-doctor.ts",
    "twitch:login": "node --import tsx scripts/twitch-login.ts",
    "twitch:smoke": "node --import tsx scripts/twitch-smoke.ts",
    "eval:matching": "node --import tsx scripts/eval.ts",
    "eval:semantic": "node --import tsx scripts/eval-semantic.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "export:public": "node --import tsx scripts/export-public.ts",
    "reader": "node --import tsx apps/server/src/http/reader.ts",
    "dev:local": "node --import tsx scripts/dev-local.ts",
    "reader:managed": "node --import tsx apps/server/src/http/managed-reader.ts",
    "ai:setup": "node --import tsx scripts/setup-ai.ts",
    "rehearse": "node --import tsx scripts/rehearse.ts",
    "eval:discovery": "node --import tsx scripts/eval-discovery.ts",
    "eval:discovery:frozen": "node --import tsx scripts/eval-discovery-frozen.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@huggingface/transformers": "^4.3.2",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.5",
    "ws": "^8.22.0"
  }
}
